{
  "manifest_version": 3,
  "name": "Minecraftly Highlighter",
  "version": "0.1.0",
  "description": "Permanent highlights on any web page: select text and press Alt+Y. Works with the free Minecraftly desktop app.",
  "key": "",
  "minimum_chrome_version": "105",
  "permissions": ["nativeMessaging", "contextMenus"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["anchor.js", "content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Minecraftly Highlighter: select text and press Alt+Y",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
  }
}
